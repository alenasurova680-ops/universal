-- Функция трансформации Локуста с полной заменяемостью мешей под черную сущность
local function MorphToLocust(isGiant)
    local char = LocalPlayer.Character
    if not char then return end
    
    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Accessory") or child:IsA("Shirt") or child:IsA("Pants") or child:IsA("ShirtGraphic") or child:IsA("CharacterMesh") then
            child:Destroy()
        end
    end

    local mult = isGiant and 3.5 or 1.0

    for _, part in ipairs(char:GetChildren()) do
        if part:IsA("BasePart") then
            part.Color = Color3.fromRGB(0, 0, 0)
            part.Material = Enum.Material.SmoothPlastic
            part.Transparency = 0
            
            -- Удаляем стандартные лица и текстуры
            for _, sub in ipairs(part:GetChildren()) do
                if sub:IsA("Decal") or sub:IsA("Texture") then sub:Destroy() end
            end

            if part.Name ~= "HumanoidRootPart" then
                local mesh = part:FindFirstChildOfClass("SpecialMesh") or Instance.new("SpecialMesh", part)
                mesh.MeshType = Enum.MeshType.FileMesh
                mesh.MeshId = "rbxassetid://98555230" -- Меш иссушенного скелета/духа
                
                if part.Name == "Head" then
                    mesh.Scale = Vector3.new(1.2 * mult, 1.2 * mult, 1.2 * mult)
                elseif part.Name:find("Torso") then
                    mesh.Scale = Vector3.new(0.6 * mult, 3.5 * mult, 0.4 * mult)
                else -- Руки и ноги вытягиваем в длинные спицы
                    mesh.Scale = Vector3.new(0.3 * mult, 5.0 * mult, 0.3 * mult)
                end
            end
        end
    end
    
    Fluent:Notify({ Title = "Locust Morph", Content = isGiant and "Активирован Большой Локуст!" or "Активирован Локуст!", Duration = 3 })
end

Tabs.Troll:AddButton({ Title = "Transform into Locust Monster", Description = "Тощий темный монстр", Callback = function() MorphToLocust(false) end })
Tabs.Troll:AddButton({ Title = "Transform into GIANT Locust", Description = "Огромная жуткая тень", Callback = function() MorphToLocust(true) end })

