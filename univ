-- ==================== MOVEMENT ====================
local WalkSpeedValue, JumpPowerValue = 16, 50
local NoclipEnabled, BhopEnabled, InfJumpEnabled, FlyEnabled = false, false, false, false
local CurrentBhopSpeed, MaxBhopSpeed = 16, 120
local FlySpeed = 50

Tabs.Movement:AddSection("Speed & Jump")
Tabs.Movement:AddSlider("SpeedSlider", {Title = "WalkSpeed", Default = 16, Min = 16, Max = 250, Rounding = 1, Callback = function(V) WalkSpeedValue = V end})
Tabs.Movement:AddSlider("JumpSlider", {Title = "JumpPower", Default = 50, Min = 50, Max = 300, Rounding = 1, Callback = function(V) JumpPowerValue = V end})

RunService.Stepped:Connect(function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and not BhopEnabled then
        LocalPlayer.Character.Humanoid.WalkSpeed = WalkSpeedValue
        LocalPlayer.Character.Humanoid.UseJumpPower = true
        LocalPlayer.Character.Humanoid.JumpPower = JumpPowerValue
    end
end)

Tabs.Movement:AddToggle("InfJumpToggle", {Title = "Infinite Jump", Default = false}):OnChanged(function(V) InfJumpEnabled = V end)
UserInputService.JumpRequest:Connect(function()
    if InfJumpEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
end)

Tabs.Movement:AddSection("Flight & Physics")
Tabs.Movement:AddToggle("NoclipToggle", {Title = "Noclip", Default = false}):OnChanged(function(V) NoclipEnabled = V end)

RunService.Stepped:Connect(function()
    if NoclipEnabled and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then part.CanCollide = false end
        end
    end
end)

Tabs.Movement:AddToggle("BhopToggle", {Title = "Bunnyhop", Default = false}):OnChanged(function(V)
    BhopEnabled = V
    if not V then CurrentBhopSpeed = WalkSpeedValue end
end)

RunService.RenderStepped:Connect(function()
    if BhopEnabled and UserInputService:IsKeyDown(Enum.KeyCode.Space) then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
            local humanoid = LocalPlayer.Character.Humanoid
            if humanoid.FloorMaterial ~= Enum.Material.Air then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                CurrentBhopSpeed = math.min(CurrentBhopSpeed + 2.5, MaxBhopSpeed)
                humanoid.WalkSpeed = CurrentBhopSpeed
            end
        end
    else
        CurrentBhopSpeed = WalkSpeedValue
    end
end)

local bodyGyro, bodyVelocity
Tabs.Movement:AddToggle("FlyToggle", {Title = "Fly", Default = false}):OnChanged(function(V)
    FlyEnabled = V
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end
    local hrp = char.HumanoidRootPart
    if FlyEnabled then
        bodyGyro = Instance.new("BodyGyro", hrp)
        bodyGyro.P = 9e4
        bodyGyro.maxTorque = Vector3.new(9e9, 9e9, 9e9)
        bodyGyro.cframe = hrp.CFrame

        bodyVelocity = Instance.new("BodyVelocity", hrp)
        bodyVelocity.velocity = Vector3.zero
        bodyVelocity.maxForce = Vector3.new(9e9, 9e9, 9e9)

        char.Humanoid.PlatformStand = true
    else
        if bodyGyro then bodyGyro:Destroy() end
        if bodyVelocity then bodyVelocity:Destroy() end
        if char:FindFirstChild("Humanoid") then char.Humanoid.PlatformStand = false end
    end
end)

Tabs.Movement:AddSlider("FlySpeedSlider", {Title = "Fly Speed", Default = 50, Min = 10, Max = 200, Rounding = 1, Callback = function(V) FlySpeed = V end})

RunService.RenderStepped:Connect(function()
    if FlyEnabled and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local moveDir = Vector3.zero
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + Camera.CFrame.RightVector end
        if bodyGyro then bodyGyro.cframe = Camera.CFrame end
        if bodyVelocity then bodyVelocity.velocity = moveDir * FlySpeed end
    end
end)

-- ==================== TROLL & FUN ====================
local SpinbotEnabled = false
local SpinSpeed = 50
local SelectedFlingPlayer = nil

Tabs.Troll:AddSection("Character Scaling")

-- Увеличение размера персонажа без изменения внешнего вида
local ScaleValue = 1
Tabs.Troll:AddSlider("SizeSlider", {
    Title = "Character Scale (Размер)",
    Default = 1,
    Min = 1,
    Max = 10,
    Rounding = 1,
    Callback = function(Value)
        ScaleValue = Value
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("Humanoid") then
            local humanoid = char.Humanoid
            local bodyScale = {"BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale"}
            for _, scaleName in ipairs(bodyScale) do
                local scaleObj = humanoid:FindFirstChild(scaleName)
                if not scaleObj then
                    scaleObj = Instance.new("NumberValue")
                    scaleObj.Name = scaleName
                    scaleObj.Parent = humanoid
                end
                scaleObj.Value = ScaleValue
            end
        end
    end
})

Tabs.Troll:AddSection("Bypass Fling & Spectate")

local FlingDropdown = Tabs.Troll:AddDropdown("FlingPlayerSelect", {
    Title = "Выбрать игрока для Fling",
    Values = {},
    Multi = false,
    Default = nil,
    Callback = function(V) SelectedFlingPlayer = V end
})

local function UpdateFlingDropdown()
    local p = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then table.insert(p, player.Name) end
    end
    FlingDropdown:SetValues(p)
end
UpdateFlingDropdown()
Players.PlayerAdded:Connect(UpdateFlingDropdown)
Players.PlayerRemoving:Connect(UpdateFlingDropdown)

Tabs.Troll:AddButton({
    Title = "Fling Selected Player",
    Description = "Флинг + привязка камеры к жертве",
    Callback = function()
        if not SelectedFlingPlayer then
            Fluent:Notify({ Title = "Ошибка", Content = "Выберите игрока!", Duration = 3 })
            return
        end

        local Target = Players:FindFirstChild(SelectedFlingPlayer)
        local Char = LocalPlayer.Character
        local HRP = Char and Char:FindFirstChild("HumanoidRootPart")

        if Target and Target.Character and Target.Character:FindFirstChild("HumanoidRootPart") and HRP then
            local TargetHRP = Target.Character.HumanoidRootPart
            local TargetHumanoid = Target.Character:FindFirstChildOfClass("Humanoid")
            local OldCFrame = HRP.CFrame

            Fluent:Notify({ Title = "Fling", Content = "Запуск и наблюдение за " .. SelectedFlingPlayer, Duration = 3 })

            -- ПРИВЯЗКА КАМЕРЫ К ЖЕРТВЕ
            if TargetHumanoid then
                Camera.CameraSubject = TargetHumanoid
            end

            -- Создаем BodyThrust для передачи кинетической энергии
            local Thrust = Instance.new("BodyThrust")
            Thrust.Parent = HRP
            Thrust.Force = Vector3.new(999999, 999999, 999999)
            Thrust.Location = Vector3.new(9999, 9999, 9999)

            local Time = tick()
            local Connection

            Connection = RunService.Heartbeat:Connect(function()
                if tick() - Time > 3 or not TargetHRP or not TargetHRP.Parent then
                    Connection:Disconnect()
                    Thrust:Destroy()
                    
                    -- Сброс скорости и возврат персонажа
                    HRP.Velocity = Vector3.zero
                    HRP.RotVelocity = Vector3.zero
                    task.wait(0.1)
                    HRP.CFrame = OldCFrame
                    
                    -- ВОЗВРАТ КАМЕРЫ ОБРАТНО К СВОЕМУ ПЕРСОНАЖУ
                    if Char and Char:FindFirstChildOfClass("Humanoid") then
                        Camera.CameraSubject = Char:FindFirstChildOfClass("Humanoid")
                    end
                    return
                end

                -- Врезаемся в цель со случайным вращением
                HRP.CFrame = TargetHRP.CFrame * CFrame.Angles(math.rad(math.random(0,360)), math.rad(math.random(0,360)), math.rad(math.random(0,360)))
                HRP.Velocity = Vector3.new(9999, 9999, 9999)
            end)
        else
            Fluent:Notify({ Title = "Ошибка", Content = "Игрок не найден!", Duration = 3 })
        end
    end
})

Tabs.Troll:AddSection("Spinbot")
Tabs.Troll:AddToggle("SpinToggle", {Title = "Spinbot", Default = false}):OnChanged(function(V) SpinbotEnabled = V end)
Tabs.Troll:AddSlider("SpinSpeedSlider", {Title = "Spin Speed", Default = 50, Min = 10, Max = 300, Rounding = 1, Callback = function(V) SpinSpeed = V end})

