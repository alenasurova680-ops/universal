-- РАБОЧИЙ МЕТОД FLING С ОБХОДОМ СЕТЕВОЙ ФИЗИКИ ROBLOX
Tabs.Troll:AddButton({
    Title = "Fling Selected Player",
    Description = "Ультра-мощный запуск игрока в космос",
    Callback = function()
        if not SelectedFlingPlayer then
            Fluent:Notify({ Title = "Ошибка", Content = "Сначала выберите игрока из списка!", Duration = 3 })
            return
        end

        local targetPlayer = Players:FindFirstChild(SelectedFlingPlayer)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and hrp and humanoid then
            local targetHrp = targetPlayer.Character.HumanoidRootPart
            local oldCFrame = hrp.CFrame
            
            Fluent:Notify({ Title = "Fling", Content = "Запуск " .. SelectedFlingPlayer .. "...", Duration = 2 })

            -- Включаем режим физической нестабильности для передачи импульса
            workspace.FallenPartsDestroyHeight = 0/0
            local Angle = 0
            local Time = tick()

            local connection
            connection = RunService.Heartbeat:Connect(function()
                if tick() - Time > 2 or not targetHrp or not targetHrp.Parent then
                    connection:Disconnect()
                    
                    -- Сброс скорости и возвращение в исходную позицию
                    hrp.AssemblyLinearVelocity = Vector3.zero
                    hrp.AssemblyAngularVelocity = Vector3.zero
                    task.wait(0.05)
                    hrp.CFrame = oldCFrame
                    return
                end

                -- Отключаем коллизии, чтобы не застревать в цели
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end

                -- Оборачиваемся вокруг игрока и передаем экстремальную физику
                Angle = Angle + 100
                hrp.CFrame = targetHrp.CFrame * CFrame.Angles(0, math.rad(Angle), 0) * CFrame.new(0, 0, 0.2)
                
                -- Генерация бесконечной физической энергии столкновения
                hrp.AssemblyLinearVelocity = Vector3.new(200000, 200000, 200000)
                hrp.AssemblyAngularVelocity = Vector3.new(200000, 200000, 200000)
            end)
        else
            Fluent:Notify({ Title = "Ошибка", Content = "Игрок не найден или слишком далеко!", Duration = 3 })
        end
    end
})

